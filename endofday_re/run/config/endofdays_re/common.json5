	// 方块破坏黑名单
	"banlist": {
		"黑曜石": "minecraft:obsidian"
	},
	// 僵尸应该主动破坏什么方块,regex前缀为正则表达式
	"FollowBlockBreak": {
		"火把": "regex:^minecraft:*torch$",
		"所有箱子": "regex:^minecraft:.*chest$",
		"工作台": "minecraft:crafting_table",
		"所有床": "regex:^minecraft:.*_bed$",
		"灵魂火把": "minecraft:soul_torch"
	},
	// 僵尸偷盗配置 container前缀为可偷盗的容器,items前缀为可偷盗的物品,regex前缀为正则表达式
	"EquipChestMob": {
		"所有箱子": "container:regex:^minecraft:.*chest$",
		"附魔金苹果": "items:minecraft:enchanted_golden_apple",
		"不死图腾": "items:minecraft:totem_of_undying",
		"所有护甲": "items:regex:^minecraft:.*_(helmet|chestplate|leggings|boots)$",
		"金苹果": "items:minecraft:golden_apple"
	},
